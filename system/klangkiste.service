[Unit]
Description=Klangkiste – RFID-Musikbox
# Nicht auf das Netzwerk warten: Figuren und Knöpfe brauchen kein WLAN, und
# die Verbindung zum Abspieler (MPD) baut die Klangkiste selbst auf, sobald er bereit ist.
After=sound.target
Wants=mpd.service

[Service]
User=klangkiste
Group=klangkiste
# Arbeitsordner muss beschreibbar sein: lgpio legt dort Hilfsdateien an.
# Das Programm selbst liegt in /opt/klangkiste und gehört root.
WorkingDirectory=/var/lib/klangkiste
Environment=PYTHONPATH=/opt/klangkiste
Environment=LG_WD=/var/lib/klangkiste
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m klangkiste --data /var/lib/klangkiste --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
# Beenden darf nie lange dauern – solange ist die Oberfläche nicht erreichbar.
TimeoutStopSec=10
RestartSec=3

[Install]
WantedBy=multi-user.target
