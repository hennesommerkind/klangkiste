[Unit]
Description=Spotify Connect (go-librespot) für die Klangkiste
After=network.target sound.target avahi-daemon.service

[Service]
User=klangkiste
Group=klangkiste
ExecStart=/usr/local/bin/go-librespot --config_dir /var/lib/klangkiste/spotify
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300

[Install]
WantedBy=multi-user.target
